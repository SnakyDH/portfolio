---
import { getLang, useTranslations } from "@i18n/utils";

const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <title>{t("dev.name")} - {t("portfolio")}</title>
  </head>
  <body class="bg-surface text-onSurface max-w-7xl mx-auto">
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
