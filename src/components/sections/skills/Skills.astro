---
import { useTranslations, getLang } from "@i18n/utils";
import SectionLayout from "@layouts/sectionLayout.astro";
import { skills } from "./skills";
import { sections } from "@components/sections/sections";
const lang = getLang(Astro.url);
const t = useTranslations(lang);
---

<SectionLayout title={t("skills.title")} id={sections.skills}>
  <div class="grid grid-cols-5 gap-10">
    {
      skills.map((skill) => (
        <div class="flex items-center justify-center hover:bg-surfaceLight p-2 rounded-2xl">
          <img src={skill.icon} alt={skill.name} height="40" width="40" />
          <span class="ml-2">{skill.name}</span>
        </div>
      ))
    }
  </div>
</SectionLayout>
