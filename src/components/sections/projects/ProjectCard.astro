---
import GitHub from "@assets/social/github.svg";
interface Props {
  title: string;
  subtitle: string;
  link?: string;
  image: string;
  platforms: string[];
  
  style?: string;
}
const { title, subtitle, link, image, platforms, style } = Astro.props;
---

<div class=`project-card ${style}` style=`background-image: url(${image});`>
  <div>
    <h3>{title}</h3>
    <h4>{subtitle}</h4>
  </div>
  <div>
    <a href={link}>
      <img
        src={GitHub.src}
        alt={GitHub.name}
        width="40px"
        height="4Project 10px"
      />
    </a>
  </div>
  <p>
    {platforms.map((platform) => {})}
  </p>
</div>
<style>
  .project-card {
    background-size: cover;
    background-position: center;
    color: white;
    padding: 1rem;
    box-shadow: inset 0 -60px 10px 10px rgba(0, 0, 0, 0.5);
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    h3 {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 700;
    }
    h4 {
      margin: 0;
      font-size: 1rem;
      font-weight: 400;
    }
  }
</style>
