---
import { languages } from "@i18n/ui";
import { getLang, useTranslatedPath } from "@i18n/utils";
import Spanish from "@assets/langs/spanish.svg";
import English from "@assets/langs/english.svg";

const language = getLang(Astro.url);
const translatePath = useTranslatedPath(language);
---

<ul class="flex gap-4 items-center">
  {
    Object.entries(languages).map(([lang, label]) => (
      <li>
        <a href={translatePath("/", lang)}>
          <img
            src={lang == "en" ? English.src : Spanish.src}
            alt={label}
            height={lang == language ? "44" : "34"}
            width={lang == language ? "44" : "34"}
          />
        </a>
      </li>
    ))
  }
</ul>
